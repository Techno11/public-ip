{
  "name": "@haythem/public-ip",
  "version": "1.0.0",
  "description": "Queries the runner's public IP address",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "lint": "eslint **/*.ts --cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haythem/public-ip.git"
  },
  "keywords": [
    "actions",
    "ip",
    "ipv4",
    "ipv6"
  ],
  "author": "Haythem Tlili",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/haythem/public-ip/issues"
  },
  "homepage": "https://github.com/haythem/public-ip#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/http-client": "^4.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "^30.4.2",
    "jest-circus": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
